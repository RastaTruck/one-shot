config/user_voices.json
data/outhan_last_report.txt

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Data & generated artifacts
data/pipeline.db
data/pipeline.db-journal
# assets 正式素材纳入 git（263MB，无单文件 > 6MB）
# 仅排除垃圾桶和原始备份目录
data/assets/_trash/
data/assets/**/_orig/
data/audio/
data/cache/
data/outputs/
data/voice_samples/
data/shot_tables/
data/audit_snapshots/
# Outhan 项目素材（refs/frames/segments/audio/scripts），运行时产生，不入库
data/projects/

# BGM 二进制（mp3，按 user 决定走外置 OSS，不入 git）
bgm/*.mp3

# 各处素材备份目录（floodfill / trash 工具产出，本地 only）
**/_orig/
**/_trash/

# OS / editor
.DS_Store
.idea/
.vscode/

# Claude / scheduler local state
.claude/scheduled_tasks.lock

# 背景图原始素材（二进制大图，按需手动同步）
背景图/

# 日报/交接文档（本地 only）
data/handoff/
