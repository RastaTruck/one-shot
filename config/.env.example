# ============ LLM ============
# DeepSeek (首选，OpenAI 兼容协议)
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Claude (备选，分镜结构化输出用)
ANTHROPIC_API_KEY=sk-ant-xxx

# ============ 图片生成：即梦（字节火山引擎）============
JIMENG_ACCESS_KEY=
JIMENG_SECRET_KEY=

# ============ 图生视频：可灵 ============
KLING_ACCESS_KEY=
KLING_SECRET_KEY=

# ============ TTS：MiniMax ============
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=

# ============ 通用 ============
# 默认 LLM 供应商: deepseek | claude
DEFAULT_LLM_PROVIDER=deepseek

# 默认音色（MiniMax voice_id）
DEFAULT_VOICE_ID=male-qn-jingying

# 审核 UI 端口
REVIEW_UI_PORT=8000
