# 复制为 config/.env 后填真值。.env 已在 .gitignore，绝不入 git。

# ========== LLM（选题 / 文案 / 分镜 / 标题 / 发布信息）==========
# 调用链：Gemini（首选）→ DeepSeek（备）→ Claude（末备）

# Gemini — Google AI Studio 免费申请，中文生成质量强
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy-xxxxxxxx
GEMINI_MODEL=gemini-2.5-flash

DEFAULT_LLM_PROVIDER=gemini

# DeepSeek — 国内访问稳，OpenAI 兼容协议（作为备用）
DEEPSEEK_API_KEY=sk-xxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ========== 火山方舟 Ark（AI 生图 / 生视频） ==========
ARK_API_KEY=
# 豆包 vision 模型 ID（看图理解 / 自动打标用）
ARK_VISION_MODEL=

# ========== 火山声音复刻（语音 ICL，可选） ==========
# 默认走免费 Edge-TTS，留位置给后续接入声音克隆
VOLC_SPEECH_APPID=
VOLC_SPEECH_TOKEN_A=
VOLC_SPEECH_TOKEN_B=

# ========== Fish Audio TTS ==========
# https://fish.audio → API Keys → 创建 key
FISH_AUDIO_API_KEY=

# ========== Tenor 抓动图（可选） ==========
# 不填走 HTML 兜底抓取，不影响日常运行
TENOR_API_KEY=

# ========== Pexels（首帧参考图在线搜图） ==========
# Outhan 步骤 1 头脑风暴 + 首帧参考图入口用：通过关键字搜图作为参考图给 Gemini。
# https://www.pexels.com/api/ 免费注册，5 分钟拿 key，免费 200 req/h，可商用。
# 留空 → 「在线搜图」按钮显示「未配置 Pexels API key」。
PEXELS_API_KEY=

# ========== 七牛云 OSS（素材云存储） ==========
# 只有 admin（上传新素材的人）需要填。read-only 协作者不需要——
# 素材通过 CDN domain 公开访问。
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
# bucket 名（七牛控制台 → 对象存储 → 空间管理）
QINIU_BUCKET=
# bucket 绑定的 CDN 加速域名（七牛"测试域名"或自购域名，不带 https://）
# 例：xxx.qiniucdn.com  /  cdn.yourdomain.com
QINIU_DOMAIN=
